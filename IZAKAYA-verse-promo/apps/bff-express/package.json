{
  "name": "izakaya-mini-bff-express",
  "version": "0.1.0",
  "private": true,
  "description": "IZAKAYA verse Mini BFF built on the IZAKAYA Stable Stack (Express/CommonJS + tsc prebuild).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "clean": "rimraf dist",
    "docker:build": "docker build -t izakaya-mini-bff .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:test": "node scripts/docker-smoketest.cjs",
    "preview:install": "npm --prefix preview-ui install",
    "preview:dev": "npm --prefix preview-ui run dev",
    "preview:build": "npm --prefix preview-ui run build",
    "up": "node ./run.mjs up",
    "down": "node ./run.mjs down",
    "status": "node ./run.mjs status",
    "logs": "node ./run.mjs logs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
